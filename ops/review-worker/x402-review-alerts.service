[Unit]
Description=Check x402 automated review queue health
After=x402-review-worker.service

[Service]
Type=oneshot
User=x402review
Group=x402review
WorkingDirectory=/opt/x402-wallet-readiness
Environment=NODE_ENV=production
EnvironmentFile=/etc/x402-wallet-readiness/review-worker.env
ExecStart=/usr/bin/node /opt/x402-wallet-readiness/scripts/review-alerts.js
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
