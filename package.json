{
  "name": "base-wallet-readiness-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Inspect and validate an x402 endpoint before an autonomous agent spends USDC.",
  "scripts": {
    "start": "node src/index.js",
    "worker": "node scripts/run-review-worker.js",
    "reconcile:settlements": "node scripts/reconcile-settlements.js",
    "test:x402-trigger": "node scripts/conditional-x402-payment.js",
    "check": "for file in public/*.js src/*.js src/mcp/*.js src/preflight/*.js src/review/*.js src/routes/*.js scripts/*.js; do node --check \"$file\"; done",
    "test": "node --test",
    "validate:bazaar": "node scripts/validate-bazaar.js",
    "verify:discovery": "node scripts/verify-discovery.js",
    "smoke:public": "node scripts/smoke-public.js",
    "verify:runtime": "node scripts/verify-runtime.js",
    "metrics:summary": "node scripts/metrics-summary.js"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@pyrimid/sdk": "^0.2.6",
    "@x402/core": "^2.13.0",
    "@x402/evm": "^2.13.0",
    "@x402/express": "^2.13.0",
    "@x402/extensions": "^2.13.0",
    "express": "^5.1.0",
    "pg": "8.16.3"
  }
}
